# StudySense backend — environment configuration template
# Copy this file to backend/.env and adjust values as needed.
# backend/.env is gitignored and should NEVER be committed.

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:latest
OLLAMA_EMBEDDING_MODEL=all-minilm:latest

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./studysense.db

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
VECTOR_DB_DIR=vector_db

# ── RAG parameters ────────────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=100
RETRIEVAL_K=3
RETRIEVAL_K_PER_DOCUMENT=3
MAX_CONTEXT_CHUNKS=6

# ── JWT Authentication (Phase 2) ──────────────────────────────────────────────
# Generate a secure secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-long-random-secret-here-replace-before-any-real-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
